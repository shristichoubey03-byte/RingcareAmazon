# ==============================================================================
# RingCare Environment Configuration
# ==============================================================================
# Ring Partner API credentials from Amazon Developer Portal
# Register at: https://developer.amazon.com/ring (Amazon Vision API)
RING_CLIENT_ID=your_ring_client_id_here
RING_CLIENT_SECRET=your_ring_client_secret_here
RING_HMAC_KEY=your_shared_hmac_secret_key_here

# Ring & Amazon Vision API endpoints
RING_BASE_URL=https://api.amazonvision.com
RING_OAUTH_URL=https://oauth.ring.com

# Demo Mode: Set to "true" to run without physical Ring hardware or credentials.
# In Demo Mode, realistic simulated devices, visitor snapshots, and webhooks are active.
DEMO_MODE=true

# Server configuration
PORT=5000
HOST=0.0.0.0
SECRET_KEY=ringcare_dev_secret_key_change_in_production

# Care Check-in Settings
CHECKIN_TARGET_TIME=10:00
CAREGIVER_NOTIFICATION_EMAIL=caregiver@family.org
DATABASE_PATH=ringcare.db
